# Shared database connection. Keep this server-only and set it in Vercel, never
# in a VITE_ variable. No database is provisioned or migrated by this project.
DATABASE_URL=

# Canonical public origin, including https and no path, query, fragment, or
# credentials. Example format only: https://your-domain.example
APP_URL=

# Clerk: VITE_ variables are intentionally public browser build values; the
# secret key is server-only. Vercel must use an external Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe is server-only. Vercel uses this standard Stripe secret-key adapter;
# Replit continues to use its connector proxy and does not use this variable.
STRIPE_SECRET_KEY=

# Optional S3-compatible private object storage for Vercel (Cloudflare R2 is
# supported). These are server-only, except uploads receive short-lived signed
# URLs at runtime. Set S3_REGION=auto for R2 and leave S3_FORCE_PATH_STYLE=true
# unless the selected S3 provider requires virtual-hosted bucket URLs.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=true

# Replit-only private object storage remains the default outside Vercel.
PRIVATE_OBJECT_DIR=

# Optional server logging level.
LOG_LEVEL=